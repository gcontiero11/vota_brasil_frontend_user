# URL base da API REST do Vota Brasil.
# Em dev local, o backend roda em http://localhost:8080.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Toggle de mocks. Quando "true", a camada de api.ts retorna dados estáticos
# do mocks.ts em vez de chamar o backend. Útil em CI ou quando a API está
# indisponível. Default: false.
NEXT_PUBLIC_USE_MOCKS=false
